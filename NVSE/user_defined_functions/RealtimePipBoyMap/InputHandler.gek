int iKeyID

begin Function {iKeyID}

	if eval iKeyID == (Goo1.AuxVarGetFlt "*PipMap_INI" 0) || (GetController && iKeyID == 14 && IsControlPressed 27)
	else
		return
	endif

	if eval Goo1.AuxVarGetFlt "*PipMap_Toggle"
		Goo1.AuxVarSetFlt "*PipMap_Toggle" 0
	elseif MenuMode || Player.IsAnimSequencePlaying "PipBoyMinimap\PipBoyRader.kf" || ModelHasBlock Player (Goo1.AuxVarGetStr "*PipMap_Block") == 0 || Player.IsIdlePlaying || Player.IsAnimPlayingEx 5 || Player.IsAnimPlayingEx 4 || Player.GetAnimAction > -1 || Player.GetIsRagdolled || Player.IsBlockingOrAiming || GetPipBoyMode != 0 || GSIV 0 > 0
		return
	else
		Goo1.AuxVarSetFlt "*PipMap_Toggle" 1
	endif

end
