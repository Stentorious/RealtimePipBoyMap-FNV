float fRotX
float fRotY
float fRotZ

begin Function {}

	; Finish animation
	if eval (Goo1.AuxVarGetFlt "*PipMap_Anim" == 3 || Goo1.AuxVarGetFlt "*PipMap_Anim" == 1) && Player.IsAnimSequencePlaying "RealtimePipBoy\Check.kf" == 0

		SGMLC (CompileScript "RealtimePipBoyMap\ProjectScreen.gek") 0

		; Update model
		Player.SetMatrPropVal "pipboyscreen:0" 8 1
		Player.SetNifBlockFlag "PipboyLightEffect:0" 0 0 1
		Player.SetNifBlockFlag "PipboyLightEffect:0" 0 0 2
		Player.SetMatrPropVal "PipboyLightEffect:0_TNW" 7 1
		Player.SetMatrPropVal "PipboyLightEffect:1_N" 7 1
		Player.SetMatrPropVal "PipboyLightEffect:1_TNW" 7 1

		; Reset block for chameleon effect
		if eval player.GetAV Chameleon > 0
			Player.SetNifBlockFlag "pipboyscreen:0" 0 1
			Player.SetMatrPropVal "pipboyscreen:0" 7 1
		endif

		; Reset knobs
		if eval ModelHasBlock Player "TabKnob"
			Player.SetNifRot "TabKnob" 0 0 (Goo1.AuxVarGetFlt "*PipMap_Cache" 0) 2 2
		endif
		if eval ModelHasBlock Player "ScrollKnob:0"
			Player.SetNifRot "ScrollKnob:0" (Goo1.AuxVarGetFlt "*PipMap_Cache" 1) 0 0 2 2
		endif

		; Reset screen texture
		Player.ProjectUITile "HUDMainMenu\ModernMinimap" "pipboyscreen:0" -1000 -1000 1 1

		; Enable controls
		EC 4
		EC 6
		EC 7
		EnablePlayerControlsAltEx 32148

		; Revert to third person
		if eval Goo1.AuxVarGetFlt "*PipMap_Cache" 2
			ToggleFirstPerson 0
		endif

		; Finish animation
		Goo1.AuxVarSetFlt "*PipMap_Anim" 0
		Goo1.AuxVarSetFlt "*PipMap_Menu" 0

		; Disable minimap updates
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_ToggleUpdate" 0

		; Enable crosshair
		SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 1
		SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 255

		; "Pip-Boy Screen Always On" compatibility
		Player.AuxVarSetFlt "*_PBSAODisable" 0

		; B42 Inertia override
		Player.AuxVarSetFlt "*_B42InertiaHolsterOverride" 0

		; Remove DoF
		AuxTimerStop "*PipMap_DoF"
		RIMOD HouseDecorationExplorer
		SetImageSpaceModTrait HouseDecorationExplorer 60 0

		DispatchEventAlt "RealtimePipMapClose"

	; Init animation start
	elseif eval Goo1.AuxVarGetFlt "*PipMap_Anim" < 2 && Goo1.AuxVarGetFlt "*PipMap_Anim" > -1 && ((IsKeyPressed (Goo1.AuxVarGetFlt "*PipMap_INI" 0) 2 && Goo1.AuxVarGetFlt "*PipMap_INI" 4 == 0) || Goo1.AuxVarGetFlt "*PipMap_Toggle" || (Goo1.AuxVarGetFlt "*PipMap_INI" 5 && Goo1.AuxVarGetFlt "*PipMap_INI" 4 == 0 && GetController && IsControlPressed 27 && IsControlPressed 14) || Goo1.AuxVarGetFlt "*PipMap_Editor")
		if eval Goo1.AuxVarGetFlt "*PipMap_Menu"
			DC 4
			DC 6
			DC 7
			Goo1.AuxVarSetFlt "*PipMap_Menu" 0
		endif
		if eval MenuMode || ModelHasBlock Player "pipboyscreen:0" == 0 || Player.IsIdlePlaying || Player.GetAnimAction > -1 || Player.GetIsRagdolled || Player.GetDead || Player.IsBlockingOrAiming || GetPipBoyMode != 0 || GSIV 0 > 0 || IsInKillCam || GetPlayerControlsDisabled 1 0 0 1 1 0 0
			return
		endif

		array_var aPipboy = Player.GetChildBlocks "Bip01 L ForeTwist" 2
		if eval (Ar_Size aPipboy) < 1 || Player.GetNifBlockFlag (aPipboy[0]) 0 2
			aPipboy = ar_Null
			return
		endif
		aPipboy = ar_Null

		; Load Pip-Boy screen INI settings
		Call (CompileScript "RealtimePipBoyMap\DetectPipBoyMesh.gek")

		; Is third person
		Goo1.AuxVarSetFlt "*PipMap_Cache" (eval IsPC1stPerson == 0) 2

		; Disable controls
		DC 4
		DC 6
		DC 7
		DisablePlayerControlsAltEx (30100 + (2048 * (Goo1.AuxVarGetFlt "*PipMap_INI" 3)))

		; Update model
		if eval ModelHasBlock Player "StatsGlow" && ModelHasBlock Player "ItemsGlow" && ModelHasBlock Player "DataGlow"
			ToggleNthPipboyLight 0 0
			ToggleNthPipboyLight 1 0
			ToggleNthPipboyLight 2 1
		endif

		if eval ModelHasBlock Player "RadNeedle"
			Player.GetNifRotAlt "RadNeedle" (fRotX) (fRotY) (fRotZ) 2 2
			fRotZ = (((Player.GetAV RadiationRads) - 500) / 500) * 90
			Player.SetNifRot "RadNeedle" (fRotX) (fRotY) (fRotZ) 2 2
		endif
		if eval ModelHasBlock Player "TabKnob"
			Player.GetNifRotAlt "TabKnob" (fRotX) (fRotY) (fRotZ) 2 2
			Goo1.AuxVarSetFlt "*PipMap_Cache" fRotZ 0
			if eval GetUIFloatAlt "HUDMainMenu\ModernMinimap\_MapMode" == 1
				Player.SetNifRot "TabKnob" 0 0 28.65 2 2
			else
				Player.SetNifRot "TabKnob" 0 0 0 2 2
			endif
		endif
		if eval ModelHasBlock Player "ScrollKnob:0"
			Player.GetNifRotAlt "ScrollKnob:0" (fRotX) (fRotY) (fRotZ) 2 2
			Goo1.AuxVarSetFlt "*PipMap_Cache" fRotX 1
		endif

		Player.SetNifBlockFlag "pipboyscreen:0" 0 0
		Player.SetNifBlockFlag "PipboyLightEffect:0" 0 1 1
		Player.SetNifBlockFlag "PipboyLightEffect:0" 0 1 2
		Player.SetMatrPropVal "PipboyLightEffect:0_TNW" 7 0
		Player.SetMatrPropVal "PipboyLightEffect:1_N" 7 0
		Player.SetMatrPropVal "PipboyLightEffect:1_TNW" 7 0
		Player.SetMatrPropVal "pipboyscreen:0" 3 1
		Player.SetMatrPropVal "pipboyscreen:0" 4 1
		Player.SetMatrPropVal "pipboyscreen:0" 5 1
		Player.SetMatrPropVal "pipboyscreen:0" 8 (Goo1.AuxVarGetFlt "*PipMap_INI" (2 - (eval Player.IsInInterior)))

		; Reset block for chameleon effect
		if eval Player.GetAV Chameleon > 0
			Player.SetMatrPropVal "pipboyscreen:0" 7 0.99
		else
			Player.SetMatrPropVal "pipboyscreen:0" 7 1
		endif

		; Start animation
		Player.DeactivateAnim "RealtimePipBoy\Check.kf" 0
		Player.ActivateAnim "RealtimePipBoy\Check.kf" 1 0 1 1 0.4
		Player.PlaySound3D NPCIdlePipBoyAccessUp
		Goo1.AuxVarSetFlt "*PipMap_Anim" 1

		; Disable crosshair
		SetUIFloatAlt "HUDMainMenu\JDC\_visible_stent" 0
		SetUIFloatAlt "HUDMainMenu\ReticleCenter\reticle_center\alpha" 0

		; Update Modern Minimap
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_ToggleUpdate" 1
		if eval GetUIFloatAlt "HUDMainMenu\ModernMinimap\_MapMode" == 1
			Call (CompileScript (Goo1.AuxVarGetStr "*Minimap_Script" 0))
		else
			Call (CompileScript "ModernMinimap\WorldMap\MainLoop.gek")
		endif

		; "Pip-Boy Screen Always On" compatibility
		Player.AuxVarSetFlt "*_PBSAODisable" 1

		; B42 Inertia override
		Player.AuxVarSetFlt "*_B42InertiaHolsterOverride" 1

		; Transition DoF in
		IMOD HouseDecorationExplorer
		Goo1.AuxVarSetFlt "*PipMap_DoF" 1
		AuxTimerStart "*PipMap_DoF" 0.5 270

		DispatchEventAlt "RealtimePipMapOpen"

		SGMLC (CompileScript "RealtimePipBoyMap\ProjectScreen.gek") 1 (Goo1.AuxVarGetFlt "*PipMap_INI" 6) 9

	; Init animation end
	elseif Goo1.AuxVarGetFlt "*PipMap_Anim" == 1 && Player.IsAnimSequencePlaying "RealtimePipBoy\Check.kf" && Player.GetAnimCurrentTime "RealtimePipBoy\Check.kf" == 2

		; Enable running
		EnablePlayerControlsAltEx 2048

		; Disable animation
		Player.DeactivateAnim "RealtimePipBoy\Check.kf" 0.4
		Player.PlaySound3D NPCIdlePipBoyAccessDown
		Goo1.AuxVarSetFlt "*PipMap_Anim" 2
		CallAfter 0.45 ({} => Goo1.AuxVarSetFlt "*PipMap_Anim" 3)

		; Transition DoF out
		Goo1.AuxVarSetFlt "*PipMap_DoF" 0
		AuxTimerStart "*PipMap_DoF" 0.5 270

	endif

end
