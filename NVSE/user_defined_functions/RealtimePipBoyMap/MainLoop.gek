begin Function {}

	if eval (Goo1.AuxVarGetFlt "*PipMap_Anim" == 3 || Goo1.AuxVarGetFlt "*PipMap_Anim" == 1) && Player.IsAnimSequencePlaying "PipBoyMinimap\PipBoyRader.kf" == 0
		Player.SetMaterialPropertyValue "pipboyscreen:0" 8 1
		if eval TogglePipBoyLight
			Player.SetMaterialPropertyValue "PipboyLightEffect:0" 7 1
		endif
		Player.ProjectUITile "HUDMainMenu\ModernMinimap" "pipboyscreen:0" -1000 -1000 1 1
		EnablePlayerControlsAltEx 32148
		Goo1.AuxVarSetFlt "*PipMap_Anim" 0
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_ToggleUpdate" 0

	elseif eval Goo1.AuxVarGetFlt "*PipMap_Anim" < 2 && ((IsKeyPressed (Goo1.AuxVarGetFlt "*PipMap_INI" 0) 2 && Goo1.AuxVarGetFlt "*PipMap_INI" 3 == 0) || Goo1.AuxVarGetFlt "*PipMap_Toggle" || (GetController && IsControlPressed 27 && IsControlPressed 14) || Goo1.AuxVarGetFlt "*PipMap_Editor")
		if eval MenuMode || Player.IsAnimSequencePlaying "PipBoyMinimap\PipBoyRader.kf" || ModelHasBlock Player "pipboyscreen:0" == 0 || Player.IsIdlePlaying || Player.IsAnimPlayingEx 5 || Player.IsAnimPlayingEx 4 || Player.GetAnimAction > -1 || Player.GetIsRagdolled || Player.IsBlockingOrAiming || GetPipBoyMode != 0 || GSIV 0 > 0
			return
		endif

		DisablePlayerControlsAltEx (30100 + (2048 * (Goo1.AuxVarGetFlt "*PipMap_INI" 2)))
		Player.SetMaterialPropertyValue "PipboyLightEffect:0" 7 0
		Player.SetMaterialPropertyValue "pipboyscreen:0" 3 1
		Player.SetMaterialPropertyValue "pipboyscreen:0" 4 1
		Player.SetMaterialPropertyValue "pipboyscreen:0" 5 1
		Player.SetMaterialPropertyValue "pipboyscreen:0" 7 1
		Player.SetMaterialPropertyValue "pipboyscreen:0" 8 (Goo1.AuxVarGetFlt "*PipMap_INI" 1)
		Player.DeactivateAnim "PipBoyMinimap\PipBoyRader.kf" 0
		Player.ActivateAnim "PipBoyMinimap\PipBoyRader.kf" 1 0 1 1 0.4
		Goo1.AuxVarSetFlt "*PipMap_Anim" 1
		SetUIFloatAlt "HUDMainMenu\ModernMinimap\_ToggleUpdate" 1

	elseif Goo1.AuxVarGetFlt "*PipMap_Anim" == 1 && Player.IsAnimSequencePlaying "PipBoyMinimap\PipBoyRader.kf" && Player.GetAnimCurrentTime "PipBoyMinimap\PipBoyRader.kf" == 2
		Player.DeactivateAnim "PipBoyMinimap\PipBoyRader.kf" 0.4
		Goo1.AuxVarSetFlt "*PipMap_Anim" 2
		EnablePlayerControlsAltEx 2048
		CallAfter 0.45 ({} => Goo1.AuxVarSetFlt "*PipMap_Anim" 3)
	endif

end
