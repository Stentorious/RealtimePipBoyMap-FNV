{
	"modName": "RealtimePipBoyMap",
	"displayName": "$modDisplayName",
	"description": "$modDescription",
	"saveFile": "Stentorious/RealtimePipBoyMap.ini",
	"minMCMVersion": 1.00,
	"minModVersion": 1.00,
	"requirements": [
		{ "type": "file", "file": "NVSE/plugins/scripts/ln_RealtimePipBoyMap.txt" }
	],
	"submenus": {
		"0": {
			"listTitle": "$modDisplayName",
			"pageTitle": "$modDisplayName",
			"active": 1,
			"columns": 1,
			"enable": 1,
			"options": {
				"1": {
					"title": "$General",
					"enable": 1,
					"type": 0
				},
				"2": {
					"title": "$Keybind",
					"enable": 1,
					"type": 3,
					"mouse": "$KeybindMouse",
					"vars": [ { "configINI": "General:iKeybind", "default": 34 } ],
					"call": { "type": "file", "value": "RealtimePipBoyMap/MCMExtender/UpdateOption.gek" }
				},
				"3": {
					"title": "$ControllerSupport",
					"type": 5,
					"enable": 1,
					"mouse": "$ControllerSupportMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 5, "configINI": "General:bControllerSupport", "default": 1 } ]
				},
				"4": {
					"title": "$ControlStyle",
					"type": 6,
					"enable": 1,
					"mouse": "$ControlStyleMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 4, "configINI": "General:iControlStyle", "default": 0 } ],
					"textOff": "$Hold",
					"textOn": "$Toggle"
				},
				"5": {
					"title": "$ForceWalk",
					"type": 5,
					"enable": 1,
					"mouse": "$ForceWalkMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 3, "configINI": "General:bForceWalk", "default": 0 } ]
				},
				"6": {
					"title": "$RenderBrightnessInterior",
					"type": 2.5,
					"enable": 1,
					"suffix": "x",
					"mouse": "$RenderBrightnessInteriorMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 1, "configINI": "General:fBrightnessInterior", "default": 1.3 } ],
					"scale": {
						"valueDecimal": 2,
						"valueIncrement": 0.01,
						"valueMin": 1,
						"valueMax": 2,
						"suffix": "x"
					}
				},
				"7": {
					"title": "$RenderBrightnessExterior",
					"type": 2.5,
					"enable": 1,
					"suffix": "x",
					"mouse": "$RenderBrightnessExteriorMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 2, "configINI": "General:fBrightnessInterior", "default": 1.75 } ],
					"scale": {
						"valueDecimal": 2,
						"valueIncrement": 0.01,
						"valueMin": 1,
						"valueMax": 2,
						"suffix": "x"
					}
				},
				"9": {
					"title": "$Performance",
					"enable": 1,
					"type": 0
				},
				"10": {
					"title": "$RefreshInterval",
					"type": 2,
					"enable": 2,
					"mouse": "$RefreshIntervalMouse",
					"vars": [ { "form": "Goo1", "auxVar": "*PipMap_INI", "key": 6, "configINI": "General:iRefreshInterval", "default": 1 } ],
					"scale": {
						"valueDecimal": 0,
						"valueIncrement": 1,
						"valueMin": 1,
						"valueMax": 5
					}
				}
			}
		}
	}
}